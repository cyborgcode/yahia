{
  "name": "yahia",
  "private": true,
  "version": "0.0.1",
  "description": "YAHIA — a multiplayer pixel-art auto-runner where death builds the road",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/client",
    "build": "npm run build --workspace apps/client",
    "preview": "npm run preview --workspace apps/client",
    "typecheck": "npm run typecheck --workspace apps/client",
    "playtest": "node tools/playtest.mjs",
    "spritesheet": "node tools/spritesheet.mjs",
    "shot": "node tools/shot.mjs",
    "bench": "node tools/bench.mjs",
    "sprites": "python3 tools/slice_sheets.py",
    "tiles": "python3 tools/slice_tiles.py",
    "hero": "python3 tools/slice_hero.py",
    "room": "node tools/dev-room.mjs",
    "room:cf": "wrangler dev --config apps/server/wrangler.toml --port 8787",
    "deploy:rooms": "wrangler deploy --config apps/server/wrangler.toml",
    "multitest": "node tools/multitest.mjs",
    "roomtest": "node tools/roomtest.mjs",
    "lobbyshot": "node tools/lobbyshot.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "wrangler": "^4.120.0",
    "ws": "^8.21.3"
  }
}
